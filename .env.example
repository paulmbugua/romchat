# RomChat backend
PORT=4000
ROMCHAT_MODE=demo
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Public app URLs
NEXT_PUBLIC_SITE_URL=https://romchat.app
NEXT_PUBLIC_BACKEND_URL=https://api.romchat.app
VITE_BACKEND_URL=http://localhost:4000

# Optional production integrations
DATABASE_URL=postgres://postgres:postgres@localhost:5432/romchat
JWT_SECRET=change-me
STRIPE_SECRET_KEY=
CLOUDINARY_URL=

# Mobile update policy (Railway/backend)
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MIN_VERSION=1.0.0
# Set latest to the newest build that is live in Play Console. Raising minimum forces older builds to update.
ROMCHAT_ANDROID_LATEST_BUILD_NUMBER=18
ROMCHAT_ANDROID_MIN_BUILD_NUMBER=1
MOBILE_FORCE_UPDATE=false
MOBILE_UPDATE_MESSAGE=
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.paulmbugua2.romchat1
MOBILE_IOS_STORE_URL=
