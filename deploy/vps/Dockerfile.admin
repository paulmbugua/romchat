FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable
COPY . .
ARG VITE_BACKEND_URL=https://server.romchat.co.ke
ARG RELEASE_SHA=unknown
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
RUN yarn install --immutable && yarn workspace @romchat/admin build && \
    printf '{"service":"romchat-admin","release":"%s"}\n' "$RELEASE_SHA" > apps/admin/dist/version.json

FROM nginx:1.27-alpine
COPY deploy/vps/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 8080
