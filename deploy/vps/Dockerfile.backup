FROM postgres:18.6-alpine

RUN apk add --no-cache age aws-cli bash coreutils jq tar tzdata
COPY deploy/vps/backup.sh /usr/local/bin/backup.sh
COPY deploy/vps/restore-test.sh /usr/local/bin/restore-test.sh
COPY deploy/vps/fingerprint.sql /usr/local/share/romchat/fingerprint.sql
RUN chmod 0755 /usr/local/bin/backup.sh /usr/local/bin/restore-test.sh
ENTRYPOINT ["/usr/local/bin/backup.sh"]
